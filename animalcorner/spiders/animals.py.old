import scrapy
from ..items import AnimalcornerItem, AnimalcornerFactsItem

class AnimalsSpider(scrapy.Spider):
    name = 'animals'
    allowed_domains = ["animalcorner.org"]
    start_urls = ["https://animalcorner.org/animals"]

    def parse(self, response):
        animals = response.css('article.animals')

        for animal in animals:
            item = AnimalcornerItem()
            item['name'] = animal.css('header.entry-header h1.entry-title::text').get()

            # 1. Count p tags after header class="entry-title", then scrape it before first h2 tags. Store as introduction
            introductory_paragraphs = []
            for paragraph in animal.css('header.entry-header + div.entry-content > p'):
                text = paragraph.extract()
                introductory_paragraphs.append({'p': text})

            facts_start_index = len(introductory_paragraphs)

            for index, element in enumerate(animal.css('div.entry-content *')):
                if element.root.tag == 'h2':
                    facts_start_index = index
                    break

            item['introduction'] = introductory_paragraphs

            # 2. Scrape h2 tags as facts
            facts = self.scrape_facts(animal, facts_start_index)
            item['facts'] = facts

            yield item

    def scrape_facts(self, animal, start_index):
        facts = []
        current_h = None

        for heading in animal.css('div.entry-content h2, h3, h4, h5, h6')[start_index:]:
            tag = heading.root.tag
            text = heading.xpath('string()').get()

            if current_h:
                facts.append(current_h)

            current_h = {tag: text, 'description': []}

        if current_h:
            facts.append(current_h)

        return facts
